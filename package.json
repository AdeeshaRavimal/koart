{
    "name": "koart-operational-platform",
    "version": "1.2.1",
    "description": "Multi-Tenant Operational & Task Management SaaS Platform for KOart Solutions",
    "main": "electron/main.js",
    "type": "commonjs",
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "koart",
        "saas",
        "task-management",
        "multi-tenant",
        "whatsapp-dispatch",
        "operational-suite"
    ],
    "author": "KOart Solutions",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "start": "node server.js",
        "dev": "node server.js",
        "desktop": "electron .",
        "dist:exe": "electron-builder --win portable"
    },
    "build": {
        "appId": "lk.koart.platform",
        "productName": "KOart Platform",
        "npmRebuild": false,
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "electron/**/*",
            "server.js",
            "server/*.js",
            "server/data/**/*",
            "public/**/*"
        ],
        "win": {
            "target": [
                "nsis",
                "portable",
                "dir"
            ],
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "KOart Platform",
            "artifactName": "KOart-Platform-Setup.exe"
        },
        "portable": {
            "artifactName": "KOart-Platform-Portable.exe"
        }
    },
    "devDependencies": {
        "electron": "^45.2.3",
        "electron-builder": "^26.18.0"
    }
}
